{
  "lsp": {
    "oxlint": {
      "initialization_options": {
        "settings": {
          "typeAware": true,
          "run": "onType",
          "fixKind": "safe_fix"
        }
      }
    },
    "oxfmt": {
      "initialization_options": {
        "settings": {
          "run": "onSave"
        }
      }
    }
  },
  "languages": {
    "TypeScript": {
      "tab_size": 2,
      "preferred_line_length": 120,
      "language_servers": [
        "tsgo",
        "oxlint",
        "oxfmt",
        "!biome",
        "!prettier",
        "!eslint",
        "!vtsls",
        "!typescript-language-server",
        "..."
      ],
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      },
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "code_actions_on_format": {
        "source.fixAll.oxc": true
      }
    },
    "TSX": {
      "tab_size": 2,
      "preferred_line_length": 120,
      "language_servers": [
        "tsgo",
        "oxlint",
        "oxfmt",
        "!biome",
        "!prettier",
        "!eslint",
        "!vtsls",
        "!typescript-language-server",
        "..."
      ],
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      },
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "code_actions_on_format": {
        "source.fixAll.oxc": true
      }
    },
    "JavaScript": {
      "tab_size": 2,
      "preferred_line_length": 120,
      "language_servers": [
        "tsgo",
        "oxlint",
        "oxfmt",
        "!biome",
        "!prettier",
        "!eslint",
        "!vtsls",
        "!typescript-language-server",
        "..."
      ],
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      },
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "code_actions_on_format": {
        "source.fixAll.oxc": true
      }
    },
    "JSON": {
      "tab_size": 2,
      "preferred_line_length": 120,
      "language_servers": ["json-language-server", "oxfmt", "!biome", "!prettier", "!eslint", "..."],
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      },
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      }
    },
    "JSONC": {
      "tab_size": 2,
      "preferred_line_length": 120,
      "language_servers": ["json-language-server", "oxfmt", "!biome", "!prettier", "!eslint", "..."],
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      },
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      }
    }
  }
}
